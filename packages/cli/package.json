{
  "name": "dollysheep",
  "version": "0.1.0",
  "type": "module",
  "description": "dolly: save the way you build software as a pattern, then apply it anywhere. The command line, the local daemon, and the GUI it serves.",
  "license": "MIT",
  "homepage": "https://github.com/gguerrei/dolly#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gguerrei/dolly.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/gguerrei/dolly/issues",
  "keywords": [
    "scaffold",
    "lint",
    "project-structure",
    "conventions",
    "patterns",
    "cli",
    "bun"
  ],
  "bin": {
    "dolly": "./dist/main.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "publishConfig": {
