{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dolly",
  "version": "0.1.1",
  "identifier": "dev.dolly.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "bun run build",
    "beforeBuildCommand": "bun run build && bun run sidecar"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "rpm", "nsis", "msi"],
    "externalBin": ["binaries/dolly"],
    "resources": {
      "../../../LICENSE": "LICENSE",
      "../../../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
